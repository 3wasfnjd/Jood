        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- All distances are studs. Geometry is baked into Joud-Hara.rbxlx.
return {
    Title = "جود — مجنونة الحارة",
    RoundSeconds = 600,
    ResetDelay = 9,
    FuseCount = 3,
    MaxCatches = 3,
    MaxActivePlayers = 6,
    WalkSpeed = 14,
    SprintSpeed = 23,
    StaminaDrain = 19,
    StaminaRecovery = 14,
    SightRange = 78,
    HearingRange = 33,
    PatrolSpeed = 9,
    ChaseSpeed = 18,
    CatchDistance = 3.6,
    HideSeconds = 22,
    InitialGrace = 16,
    RespawnGrace = 8,
    Spawn = Vector3.new(0, 4, 136),
    JoudSpawn = Vector3.new(0, 3.2, 53),
    SafeCenter = Vector3.new(0, 0, 136),
    SafeHalf = Vector3.new(19, 18, 17),
    ExitCenter = Vector3.new(0, 0, -168),
    ExitHalf = Vector3.new(10, 18, 10),
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0001742">
        <Properties>
          <string name="Name">Rules</string>
          <ProtectedString name="Source">-- Pure game rules. No Roblox services; also exercised by tests/rules_test.lua.
local Rules = {}

function Rules.new(required)
    return {stage = "Idle", fuses = {}, count = 0, required = required or 3,
        powered = false, hasKey = false, gateOpen = false, elapsed = 0}
end

function Rules.start(s)
    if s.stage ~= "Idle" then return false end
    s.stage = "Fuses"
    return true
end

function Rules.collect(s, id)
    if s.stage ~= "Fuses" or type(id) ~= "string" or s.fuses[id] then return false end
    s.fuses[id] = true
    s.count = s.count + 1
    if s.count &gt;= s.required then s.stage = "Generator" end
    return true
end

function Rules.power(s)
    if s.stage ~= "Generator" or s.count &lt; s.required then return false end
    s.powered = true
    s.stage = "Key"
    return true
end

function Rules.key(s)
    if s.stage ~= "Key" or not s.powered then return false end
    s.hasKey = true
    s.stage = "Gate"
    return true
end

function Rules.gate(s)
    if s.stage ~= "Gate" or not s.hasKey then return false end
    s.gateOpen = true
    s.stage = "Escape"
    return true
end

function Rules.isRunning(s)
    return s.stage ~= "Idle" and s.stage ~= "Ended"
end

function Rules.tick(s, dt, limit)
    if not Rules.isRunning(s) then return false end
    s.elapsed = s.elapsed + math.max(0, dt)
    if s.elapsed &gt;= limit then
        s.stage = "Ended"
        s.reason = "timeout"
        return true
    end
    return false
end

function Rules.finish(s, reason)
    if s.stage == "Idle" or s.stage == "Ended" then return false end
    s.stage = "Ended"
    s.reason = reason
    return true
end

function Rules.snapshot(s, limit)
    return {stage = s.stage, count = s.count, required = s.required,
        powered = s.powered, gateOpen = s.gateOpen,
        seconds = math.max(0, math.ceil(limit - s.elapsed))}
end

return Rules
</ProtectedString>
        </Properties>
      </Item>
    <Item class="Folder" referent="RBX_REALISTIC_00001"><Properties><string name="Name">JoudEmbeddedAssets</string></Properties><Item class="Folder" referent="RBX_REALISTIC_00002"><Properties><string name="Name">Vertices</string></Properties><Item class="StringValue" referent="RBX_REALISTIC_00003"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX_REALISTIC_00004"><Properties><string name="Name">0002</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX_REALISTIC_00005"><Properties><string name="Name">0003</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX_REALISTIC_00006"><Properties><string name="Name">0004</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX_REALISTIC_00007"><Properties><string name="Name">0005</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX_REALISTIC_00008"><Properties><string name="Name">0006</string><string name="Value"></string></Properties></Item></Item><Item class="Folder" referent="RBX_REALISTIC_00009"><Properties><string name="Name">Triangles</string></Properties><Item class="StringValue" referent="RBX_REALISTIC_00010"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX_REALISTIC_00011"><Properties><string name="Name">0002</string><string name="Value"></string></Properties></Item></Item><Item class="Folder" referent="RBX_REALISTIC_00012"><Properties><string name="Name">Texture</string></Properties><Item class="StringValue" referent="RBXJOUDTEX0001"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0002"><Properties><string name="Name">0002</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0003"><Properties><string name="Name">0003</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0004"><Properties><string name="Name">0004</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0005"><Properties><string name="Name">0005</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0006"><Properties><string name="Name">0006</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0007"><Properties><string name="Name">0007</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0008"><Properties><string name="Name">0008</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0009"><Properties><string name="Name">0009</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0010"><Properties><string name="Name">0010</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0011"><Properties><string name="Name">0011</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0012"><Properties><string name="Name">0012</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0013"><Properties><string name="Name">0013</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0014"><Properties><string name="Name">0014</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0015"><Properties><string name="Name">0015</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBXJOUDTEX0016"><Properties><string name="Name">0016</string><string name="Value"></string></Properties></Item></Item><Item class="ModuleScript" referent="RBX_REALISTIC_00076"><Properties><string name="Name">Manifest</string><ProtectedString name="Source">return {["version"]=1,["vertexCount"]=10617,["triangleCount"]=9365,["textureSize"]=512,["heightMeters"]=1.7,["size"]={2.354990104184965,6.07142857142857,1.7707097796899014},["blobs"]={["vertices"]={["chunks"]=6,["bytes"]=339744,["sha256"]="6f8a3f102eb21d120309e138bb5f67da45702beae03f606f6eae25a7bbc3418f"},["triangles"]={["chunks"]=2,["bytes"]=56190,["sha256"]="90610746f26508a34872a9c2c3ccfd2d9b96148293a364763948308c5c8a5de1"},["texture"]={["chunks"]=16,["bytes"]=1048576,["sha256"]="92913c1074571622b7b6aa2c672bec8e3252df01890d27911048029ab1a0e95a"}}}</ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX_REALISTIC_00077"><Properties><string name="Name">RealisticJoud</string><ProtectedString name="Source">-- Self-contained NPC presentation. Geometry and texture bytes are embedded
-- under HaraShared/JoudEmbeddedAssets. No asset IDs or HTTP downloads are used.
local AssetService = game:GetService("AssetService")
local EncodingService = game:GetService("EncodingService")
local RunService = game:GetService("RunService")
local M = {}
local keepAlive = {}

local function readBlob(folder, entry)
    local pieces = table.create(entry.chunks)
    for i = 1, entry.chunks do
        local chunk = folder:WaitForChild(string.format("%04d", i), 60)
        assert(chunk and chunk:IsA("StringValue"), "Missing embedded character chunk")
        pieces[i] = chunk.Value
    end
    local compressed = EncodingService:Base64Decode(buffer.fromstring(table.concat(pieces)))
    local decoded = EncodingService:DecompressBuffer(compressed, Enum.CompressionAlgorithm.Zstd)
    assert(buffer.len(decoded) == entry.bytes, "Embedded character size mismatch")
    return decoded
end

-- Kept separate from placement so binary decoding and topology can be checked.
function M.BuildFromBuffers(vertices, indices, pixels, spec, progress)
    assert(buffer.len(vertices) == spec.vertexCount * 32, "Invalid vertex buffer")
    assert(buffer.len(indices) == spec.triangleCount * 6, "Invalid index buffer")
    assert(buffer.len(pixels) == spec.textureSize * spec.textureSize * 4, "Invalid pixel buffer")
    local mesh = AssetService:CreateEditableMesh()
    assert(mesh, "EditableMesh memory budget unavailable")
    local image, part
    local ok, failure = pcall(function()
        local vertexIds = table.create(spec.vertexCount)
        local normalIds = table.create(spec.vertexCount)
        local uvIds = table.create(spec.vertexCount)
        for i = 1, spec.vertexCount do
            local offset = (i - 1) * 32
            vertexIds[i] = mesh:AddVertex(Vector3.new(
                buffer.readf32(vertices, offset), buffer.readf32(vertices, offset + 4),
                buffer.readf32(vertices, offset + 8)))
            normalIds[i] = mesh:AddNormal(Vector3.new(
                buffer.readf32(vertices, offset + 12), buffer.readf32(vertices, offset + 16),
                buffer.readf32(vertices, offset + 20)))
            uvIds[i] = mesh:AddUV(Vector2.new(
                buffer.readf32(vertices, offset + 24), buffer.readf32(vertices, offset + 28)))
            if i % 384 == 0 then
                if progress then progress(0.1 + 0.35 * i / spec.vertexCount) end
                task.wait()
            end
        end
        for i = 1, spec.triangleCount do
            local offset = (i - 1) * 6
            local a = buffer.readu16(indices, offset) + 1
            local b = buffer.readu16(indices, offset + 2) + 1
            local c = buffer.readu16(indices, offset + 4) + 1
            assert(vertexIds[a] and vertexIds[b] and vertexIds[c], "Invalid triangle index")
            local face = mesh:AddTriangle(vertexIds[a], vertexIds[b], vertexIds[c])
            mesh:SetFaceNormals(face, {normalIds[a], normalIds[b], normalIds[c]})
            mesh:SetFaceUVs(face, {uvIds[a], uvIds[b], uvIds[c]})
            if i % 384 == 0 then
                if progress then progress(0.45 + 0.35 * i / spec.triangleCount) end
                task.wait()
            end
        end
        image = AssetService:CreateEditableImage({Size = Vector2.new(spec.textureSize, spec.textureSize)})
        assert(image, "EditableImage memory budget unavailable")
        image:WritePixelsBuffer(Vector2.zero, Vector2.new(spec.textureSize, spec.textureSize), pixels)
        if progress then progress(0.9) end
        part = AssetService:CreateMeshPartAsync(Content.fromObject(mesh), {
            CollisionFidelity = Enum.CollisionFidelity.Box,
        })
        part.Name = "RealisticAppearance"
        part.TextureContent = Content.fromObject(image)
        part.Size = Vector3.new(spec.size[1], spec.size[2], spec.size[3])
        part.DoubleSided = true
        part.Material = Enum.Material.SmoothPlastic
        part.Color = Color3.new(1, 1, 1)
        part.Transparency = 0
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CastShadow = true
        part.Massless = true
    end)
    if not ok then
        if part then part:Destroy() end
        if image then image:Destroy() end
        mesh:Destroy()
        error(failure, 0)
    end
    return part, mesh, image
end

function M.Attach(joud, progress)
    local existing = joud:FindFirstChild("RealisticAppearance")
    if existing then return existing end
    local assets = script.Parent:WaitForChild("JoudEmbeddedAssets")
    local spec = require(assets:WaitForChild("Manifest"))
    if progress then progress(0.02) end
    local vertices = readBlob(assets:WaitForChild("Vertices"), spec.blobs.vertices)
    local indices = readBlob(assets:WaitForChild("Triangles"), spec.blobs.triangles)
    local pixels = readBlob(assets:WaitForChild("Texture"), spec.blobs.texture)
    local visual, mesh, image = M.BuildFromBuffers(vertices, indices, pixels, spec, progress)
    local root = joud:WaitForChild("HumanoidRootPart")
    local offset = CFrame.new(0, -3 + spec.size[2] / 2, 0)
    visual.CFrame = root.CFrame * offset
    -- Only hide the old appearance once the complete textured replacement exists.
    -- The server's R6 rig remains responsible for navigation and captures.
    for _, obj in ipairs(joud:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        end
    end
    visual.Parent = joud
    local nameplate = joud:FindFirstChild("Nameplate", true)
    if nameplate and nameplate:IsA("BillboardGui") then
        nameplate.StudsOffset = Vector3.new(0, spec.size[2] - 4.05, 0)
    end
    local connection
    connection = RunService.PreRender:Connect(function()
        if not visual.Parent or not root.Parent then
            connection:Disconnect()
            return
        end
        local t = os.clock()
        local velocity = root.AssemblyLinearVelocity
        local moving = Vector3.new(velocity.X, 0, velocity.Z).Magnitude &gt; 0.6
        local hunt = joud:GetAttribute("Mood") == "Hunt"
        local lift = moving and math.sin(t * (hunt and 5 or 2.4)) * 0.035 or 0
        local lean = moving and (hunt and -0.035 or -0.015) or 0
        visual.CFrame = root.CFrame * CFrame.new(0, lift, 0) * offset
            * CFrame.Angles(lean, 0, math.sin(t * 0.9) * 0.008)
    end)
    keepAlive[joud] = {mesh = mesh, image = image, part = visual, connection = connection}
    if progress then progress(1) end
    return visual
end

return M
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX_REST_00092"><Properties><string name="Name">RestHouseEmbeddedAssets</string></Properties><Item class="Folder" referent="RBX_REST_00093"><Properties><string name="Name">Texture</string></Properties><Item class="StringValue" referent="RBX_REST_00094"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item></Item><Item class="Folder" referent="RBX_REST_00095"><Properties><string name="Name">RestHouseMaterial0</string></Properties><Item class="Folder" referent="RBX_REST_00096"><Properties><string name="Name">Vertices</string></Properties><Item class="StringValue" referent="RBX_REST_00097"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX_REST_00098"><Properties><string name="Name">0002</string><string name="Value"></string></Properties></Item></Item><Item class="Folder" referent="RBX_REST_00099"><Properties><string name="Name">Triangles</string></Properties><Item class="StringValue" referent="RBX_REST_00100"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item></Item></Item><Item class="Folder" referent="RBX_REST_00101"><Properties><string name="Name">RestHouseMaterial1</string></Properties><Item class="Folder" referent="RBX_REST_00102"><Properties><string name="Name">Vertices</string></Properties><Item class="StringValue" referent="RBX_REST_00103"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item></Item><Item class="Folder" referent="RBX_REST_00104"><Properties><string name="Name">Triangles</string></Properties><Item class="StringValue" referent="RBX_REST_00105"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item></Item></Item><Item class="Folder" referent="RBX_REST_00106"><Properties><string name="Name">RestHouseMaterial2</string></Properties><Item class="Folder" referent="RBX_REST_00107"><Properties><string name="Name">Vertices</string></Properties><Item class="StringValue" referent="RBX_REST_00108"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item></Item><Item class="Folder" referent="RBX_REST_00109"><Properties><string name="Name">Triangles</string></Properties><Item class="StringValue" referent="RBX_REST_00110"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item></Item></Item><Item class="Folder" referent="RBX_REST_00111"><Properties><string name="Name">RestHouseMaterial3</string></Properties><Item class="Folder" referent="RBX_REST_00112"><Properties><string name="Name">Vertices</string></Properties><Item class="StringValue" referent="RBX_REST_00113"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item></Item><Item class="Folder" referent="RBX_REST_00114"><Properties><string name="Name">Triangles</string></Properties><Item class="StringValue" referent="RBX_REST_00115"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item></Item></Item><Item class="Folder" referent="RBX_REST_00116"><Properties><string name="Name">RestHouseMaterial4</string></Properties><Item class="Folder" referent="RBX_REST_00117"><Properties><string name="Name">Vertices</string></Properties><Item class="StringValue" referent="RBX_REST_00118"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item></Item><Item class="Folder" referent="RBX_REST_00119"><Properties><string name="Name">Triangles</string></Properties><Item class="StringValue" referent="RBX_REST_00120"><Properties><string name="Name">0001</string><string name="Value"></string></Properties></Item></Item></Item><Item class="ModuleScript" referent="RBX_REST_00121"><Properties><string name="Name">RestHouseManifest</string><ProtectedString name="Source">return {["version"]=1,["textureSize"]=512,["texture"]={["chunks"]=1,["bytes"]=1048576,["sha256"]="6e9b4a5140a33fb2b658e0869c7a2ccf7ea9868f1c642883a3c9449d0e8a2d34"},["groups"]={{["name"]="RestHouseMaterial0",["vertexCount"]=11643,["triangleCount"]=5620,["center"]={18.57142959322248,8.258928252117974,75.71428418159485},["size"]={142.85714626312256,17.80357084103993,197.14285475867132},["material"]="SmoothPlastic",["textured"]=false,["vertices"]={["chunks"]=2,["bytes"]=512292,["sha256"]="2d799331bbb79900c1c7f38a2425654065cf2842db0419cbe304e814b5e91eab"},["triangles"]={["chunks"]=1,["bytes"]=33720,["sha256"]="d4659a40ab832f5a9e4b7d5c621710f12282efd4a9c89584a43274ec2b03da21"}},{["name"]="RestHouseMaterial1",["vertexCount"]=5664,["triangleCount"]=2676,["center"]={17.553569589342388,6.664285855367779,73.6518842585476},["size"]={128.6428553717477,13.400000453527484,164.2105137094673},["material"]="Metal",["textured"]=false,["vertices"]={["chunks"]=1,["bytes"]=249216,["sha256"]="0c5530bb612faa5034b983acd17dd6fb78df5b20d3828582d2152e30590d73b6"},["triangles"]={["chunks"]=1,["bytes"]=16056,["sha256"]="3a87d930531ce858441f0f6c32613911b29b0aadec743f95fba8248c3af39485"}},{["name"]="RestHouseMaterial2",["vertexCount"]=6120,["triangleCount"]=2040,["center"]={18.518536431448798,7.145008531266024,73.6419330750193},["size"]={134.96843065534318,14.499670094145195,137.44551922593797},["material"]="SmoothPlastic",["textured"]=false,["vertices"]={["chunks"]=1,["bytes"]=269280,["sha256"]="4273952ad362ef128fad74bb3a03aa05754100a3b74880b5ded6ba974d114cd5"},["triangles"]={["chunks"]=1,["bytes"]=12240,["sha256"]="340b6ec06d3288c5d16952d7fcb695f088293f0a54170b5c1c6a8e625821135e"}},{["name"]="RestHouseMaterial3",["vertexCount"]=240,["triangleCount"]=120,["center"]={8.241072722843715,6.339285682354654,79.20357116631098},["size"]={109.76786272866386,10.535714349576404,153.0535706451961},["material"]="SmoothPlastic",["textured"]=false,["vertices"]={["chunks"]=1,["bytes"]=10560,["sha256"]="4dbfcf6be1bfd92b09b5a351f87e396cff329432aa2078774131f2d6a301b1e2"},["triangles"]={["chunks"]=1,["bytes"]=720,["sha256"]="1288bf3f5d70c9f88b00c85a69a3097a78d97abfdc274eac6321cebfe892a861"}},{["name"]="RestHouseMaterial4",["vertexCount"]=289,["triangleCount"]=180,["center"]={17.857142857142854,0.37499998829194475,70.28571111815316},["size"]={138.5714258466448,0.7499999765838895,186.28570863178794},["material"]="SmoothPlastic",["textured"]=true,["vertices"]={["chunks"]=1,["bytes"]=12716,["sha256"]="18a28eb393a572d820ba869c015b4c59e6aff5e4119fb29a28ef3f1ef1afff8e"},["triangles"]={["chunks"]=1,["bytes"]=1080,["sha256"]="02cb7e6b18a2a27a86d40c5f32f2c8921a8d92ca328448dec27cba1291987864"}}}}</ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX_REST_00122"><Properties><string name="Name">RestHouse</string><ProtectedString name="Source">-- Loads the user's original rest-house geometry. Server Parts own collision.
local AssetService = game:GetService("AssetService")
local EncodingService = game:GetService("EncodingService")
local M = {}
local keepAlive

local function readBlob(folder, spec)
    local chunks = table.create(spec.chunks)
    for i = 1, spec.chunks do
        local value = folder:WaitForChild(string.format("%04d", i), 60)
        assert(value and value:IsA("StringValue"), "Missing rest-house payload")
        chunks[i] = value.Value
    end
    local compressed = EncodingService:Base64Decode(buffer.fromstring(table.concat(chunks)))
    local data = EncodingService:DecompressBuffer(compressed, Enum.CompressionAlgorithm.Zstd)
    assert(buffer.len(data) == spec.bytes, "Rest-house payload size mismatch")
    return data
end

function M.BuildGroup(vertices, triangles, spec, texture)
    assert(buffer.len(vertices) == spec.vertexCount * 44, "Invalid rest-house vertices")
    assert(buffer.len(triangles) == spec.triangleCount * 6, "Invalid rest-house faces")
    local mesh = AssetService:CreateEditableMesh()
    assert(mesh, "Rest-house mesh memory budget unavailable")
    local part
    local ok, failure = pcall(function()
        local vids, nids, uids, cids = {}, {}, {}, {}
        for i = 1, spec.vertexCount do
            local o = (i - 1) * 44
            vids[i] = mesh:AddVertex(Vector3.new(buffer.readf32(vertices,o),buffer.readf32(vertices,o+4),buffer.readf32(vertices,o+8)))
            nids[i] = mesh:AddNormal(Vector3.new(buffer.readf32(vertices,o+12),buffer.readf32(vertices,o+16),buffer.readf32(vertices,o+20)))
            uids[i] = mesh:AddUV(Vector2.new(buffer.readf32(vertices,o+24),buffer.readf32(vertices,o+28)))
            cids[i] = mesh:AddColor(Color3.new(buffer.readf32(vertices,o+32),buffer.readf32(vertices,o+36),buffer.readf32(vertices,o+40)),1)
            if i % 512 == 0 then task.wait() end
        end
        for i = 1, spec.triangleCount do
            local o = (i - 1) * 6
            local a,b,c = buffer.readu16(triangles,o)+1,buffer.readu16(triangles,o+2)+1,buffer.readu16(triangles,o+4)+1
            assert(vids[a] and vids[b] and vids[c], "Invalid rest-house triangle index")
            local f = mesh:AddTriangle(vids[a],vids[b],vids[c])
            mesh:SetFaceNormals(f,{nids[a],nids[b],nids[c]})
            mesh:SetFaceUVs(f,{uids[a],uids[b],uids[c]})
            mesh:SetFaceColors(f,{cids[a],cids[b],cids[c]})
            if i % 512 == 0 then task.wait() end
        end
        mesh:RemoveUnused()
        part = AssetService:CreateMeshPartAsync(Content.fromObject(mesh),{CollisionFidelity=Enum.CollisionFidelity.Box})
        part.Name = spec.name
        part.Size = Vector3.new(spec.size[1],spec.size[2],spec.size[3])
        part.Material = spec.material == "Metal" and Enum.Material.Metal or Enum.Material.SmoothPlastic
        part.Color = Color3.new(1,1,1)
        part.DoubleSided = true
        part.Anchored = true
        part.CanCollide,part.CanTouch,part.CanQuery = false,false,false
        part.CastShadow = true
        if spec.textured then part.TextureContent = Content.fromObject(texture) end
    end)
    if not ok then
        if part then part:Destroy() end
        mesh:Destroy()
        error(failure,0)
    end
    return part,mesh
end

function M.Attach(world, progress)
    local model = world:WaitForChild("Architecture"):WaitForChild("RestHouse")
    if model:FindFirstChild("RestHouseVisual") then return end
    local origin = model:WaitForChild("EntranceOrigin")
    local assets = script.Parent:WaitForChild("RestHouseEmbeddedAssets")
    local spec = require(assets:WaitForChild("RestHouseManifest"))
    local image, visual
    local meshes = {}
    local ok, failure = pcall(function()
        local pixels = readBlob(assets:WaitForChild("Texture"),spec.texture)
        image = AssetService:CreateEditableImage({Size=Vector2.new(spec.textureSize,spec.textureSize)})
        assert(image,"Rest-house texture memory budget unavailable")
        image:WritePixelsBuffer(Vector2.zero,Vector2.new(spec.textureSize,spec.textureSize),pixels)
        visual = Instance.new("Model")
        visual.Name = "RestHouseVisual"
        for i,group in ipairs(spec.groups) do
            local folder = assets:WaitForChild(group.name)
            local vertices = readBlob(folder:WaitForChild("Vertices"),group.vertices)
            local indices = readBlob(folder:WaitForChild("Triangles"),group.triangles)
            local part,mesh = M.BuildGroup(vertices,indices,group,image)
            table.insert(meshes,mesh)
            part.Parent = visual
            part.CFrame = origin.CFrame * CFrame.new(group.center[1],group.center[2],group.center[3])
            if progress then progress(i/#spec.groups) end
        end
    end)
    if not ok then
        if visual then visual:Destroy() end
        for _,mesh in ipairs(meshes) do mesh:Destroy() end
        if image then image:Destroy() end
        error(failure,0)
    end
    visual.Parent = model
    for _,part in ipairs(model:WaitForChild("Colliders"):GetChildren()) do
        if part:IsA("BasePart") then part.Transparency = 1 end
    end
    keepAlive = {visual=visual,meshes=meshes,image=image}
end
return M
</ProtectedString></Properties></Item></Item>
