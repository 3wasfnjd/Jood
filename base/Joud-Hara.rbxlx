danger.TextColor3=accent
local reticle=text(hud,"·",26,UDim2.new(0.5,-10,0.5,-15),UDim2.fromOffset(20,30))
local bar=new("Frame",hud,{Position=UDim2.new(0.5,-80,1,-52),Size=UDim2.fromOffset(160,6),
