        "FogStart": 10,
        "FogEnd": 140,
        "FogColor": [0.02, 0.02, 0.03],
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0,
        "EnvironmentSpecularScale": 0,
        "Technology": "Future"
      }
    }
  }
}
